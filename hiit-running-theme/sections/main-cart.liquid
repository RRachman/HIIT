<section class="section-spacing page-width" id="MainCart-{{ section.id }}" data-section-id="{{ section.id }}">
  <div style="border-bottom: 1px solid var(--color-border); padding-bottom: 1.5rem; margin-bottom: 2.5rem;">
    <h1 style="font-size: clamp(2rem, 3.5vw, 3rem); letter-spacing: -0.03em;">
      {{ 'cart.title' | t }}
    </h1>
  </div>

  {%- if cart.item_count == 0 -%}
    <div style="text-align: center; padding: 5rem 1rem;">
      <p style="font-size: 1.125rem; color: var(--color-text-secondary); margin-bottom: 2rem;">
        {{ 'cart.empty' | t }}
      </p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">
        {{ 'general.continue_shopping' | t }}
      </a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" id="cart" class="cart-form">
      <div style="display: grid; grid-template-columns: 1fr; gap: 3.5rem;" class="cart-layout-grid">
        {%- comment -%} Items Table {%- endcomment -%}
        <div>
          <div style="display: grid; grid-template-columns: 1fr auto; padding-bottom: 1rem; border-bottom: 1px solid var(--color-border); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; color: var(--color-text-secondary); text-transform: uppercase;">
            <span>PRODUCT</span>
            <span>TOTAL</span>
          </div>

          <div class="cart-items-list">
            {%- for item in cart.items -%}
              <div class="cart-item-row" style="display: grid; grid-template-columns: auto 1fr auto; gap: 1.5rem; padding: 1.75rem 0; border-bottom: 1px solid var(--color-border); align-items: center;">
                <div style="width: 80px; height: 104px; background: var(--color-bg-secondary); overflow: hidden;">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
                  {%- endif -%}
                </div>

                <div>
                  <h3 style="font-size: 1rem; font-weight: 800; text-transform: uppercase;">
                    <a href="{{ item.url }}">{{ item.product.title }}</a>
                  </h3>
                  {%- unless item.product.has_only_default_variant -%}
                    <p style="font-size: 0.8125rem; color: var(--color-text-secondary); margin-top: 0.25rem;">
                      {{ item.variant.title }}
                    </p>
                  {%- endunless -%}

                  <div style="font-size: 0.875rem; font-weight: 700; margin: 0.5rem 0;">
                    {{ item.final_price | money }}
                  </div>

                  <div style="display: flex; align-items: center; gap: 1rem;">
                    <div class="quantity-box" style="height: 34px;">
                      <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" class="quantity-btn" style="width: 32px; height: 32px;">-</a>
                      <input type="text" value="{{ item.quantity }}" readonly class="quantity-input" style="width: 32px;">
                      <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" class="quantity-btn" style="width: 32px; height: 32px;">+</a>
                    </div>
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" style="font-size: 0.75rem; color: var(--color-text-secondary); text-decoration: underline;">
                      {{ 'cart.remove' | t }}
                    </a>
                  </div>
                </div>

                <div style="font-size: 1rem; font-weight: 800; text-align: right;">
                  {{ item.final_line_price | money }}
                </div>
              </div>
            {%- endfor -%}
          </div>

          {%- if settings.enable_cart_notes -%}
            <div style="margin-top: 2rem;">
              <label for="CartNote" style="display: block; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.5rem;">
                {{ 'cart.note' | t }}
              </label>
              <textarea
                name="note"
                id="CartNote"
                rows="3"
                style="width: 100%; border: 1px solid var(--color-border); background: var(--color-white); padding: 0.75rem; font-size: 0.875rem; outline: none;"
              >{{ cart.note }}</textarea>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} Order Summary Sidebar {%- endcomment -%}
        <div>
          <div style="background-color: var(--color-bg-secondary); border: 1px solid var(--color-border); padding: 2rem;">
            <h2 style="font-size: 1.125rem; font-weight: 800; text-transform: uppercase; margin-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); padding-bottom: 1rem;">
              ORDER SUMMARY
            </h2>

            <div style="display: flex; justify-content: space-between; margin-bottom: 1rem; font-size: 0.9375rem;">
              <span>Subtotal</span>
              <span style="font-weight: 800;">{{ cart.total_price | money }}</span>
            </div>

            <div style="font-size: 0.75rem; color: var(--color-text-secondary); margin-bottom: 1.75rem; line-height: 1.5;">
              {{ 'cart.taxes_included_and_shipping_policy_html' | t }}
            </div>

            <button type="submit" name="checkout" class="btn btn-primary" style="width: 100%; margin-bottom: 0.75rem;">
              {{ 'cart.checkout' | t }}
            </button>

            <a href="{{ routes.all_products_collection_url }}" class="btn btn-secondary" style="width: 100%;">
              {{ 'general.continue_shopping' | t }}
            </a>
          </div>
        </div>
      </div>
    </form>
  {%- endif -%}
</section>

<style>
  @media (min-width: 960px) {
    .cart-layout-grid {
      grid-template-columns: 1fr 380px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
