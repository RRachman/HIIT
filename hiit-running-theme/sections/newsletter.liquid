<section class="newsletter-section" id="Newsletter-{{ section.id }}">
  <div class="newsletter-content">
    <div style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255, 255, 255, 0.6); margin-bottom: 0.75rem;">
      COMMUNITY FIRST
    </div>

    <h2 class="newsletter-headline">
      {{ section.settings.heading | default: 'JOIN THE HIIT COMMUNITY.' }}
    </h2>

    <p class="newsletter-subtext">
      {{ section.settings.subtext | default: 'Stay connected with new collections, releases, and running inspiration.' }}
    </p>

    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      
      {%- if form.posted_successfully? -%}
        <div style="background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3); padding: 1rem 1.5rem; color: #fff; font-weight: 600; font-size: 0.875rem; width: 100%;">
          {{ 'sections.newsletter.success_message' | t }}
        </div>
      {%- else -%}
        {%- if form.errors -%}
          <div style="color: #ff6b6b; font-size: 0.8125rem; margin-bottom: 0.5rem; text-align: left; width: 100%;">
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </div>
        {%- endif -%}

        <input
          type="email"
          name="contact[email]"
          class="newsletter-input"
          value="{{ form.email }}"
          placeholder="{{ 'sections.newsletter.email_placeholder' | t }}"
          aria-label="{{ 'sections.newsletter.email_placeholder' | t }}"
          required
        >
        <button type="submit" class="btn btn-white" style="white-space: nowrap;">
          {{ section.settings.button_text | default: 'SUBSCRIBE' }}
        </button>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "JOIN THE HIIT COMMUNITY."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Supporting text",
      "default": "Stay connected with new collections, releases, and running inspiration."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SUBSCRIBE"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
