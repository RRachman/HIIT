{%- if section.settings.show_announcement -%}
  <div class="announcement-bar" role="region" aria-label="Announcement" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" style="color: inherit; text-decoration: none;">
        {{ section.settings.text }}
      </a>
    {%- else -%}
      <span>{{ section.settings.text }}</span>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "FREE SHIPPING ON SELECTED ORDERS OVER $100"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#101214"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
