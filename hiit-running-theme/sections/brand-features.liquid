<section class="section-spacing page-width" id="BrandFeatures-{{ section.id }}">
  <div class="brand-features-grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="feature-column" {{ block.shopify_attributes }}>
          <div class="feature-number">{{ block.settings.number }}</div>
          <h3 class="feature-title">{{ block.settings.title }}</h3>
          <p class="feature-desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="feature-column">
        <div class="feature-number">01 — LIGHTWEIGHT</div>
        <h3 class="feature-title">ENGINEERED COMFORT</h3>
        <p class="feature-desc">Comfort-focused apparel designed for ease of movement and zero friction over long endurance miles.</p>
      </div>
      <div class="feature-column">
        <div class="feature-number">02 — FUNCTIONAL</div>
        <h3 class="feature-title">PURPOSE-BUILT DETAILS</h3>
        <p class="feature-desc">Practical silhouettes for running and active everyday life, featuring secure zip storage and thermal regulation.</p>
      </div>
      <div class="feature-column">
        <div class="feature-number">03 — OWN YOUR PACE</div>
        <h3 class="feature-title">INDIVIDUAL PROGRESS</h3>
        <p class="feature-desc">Every run is different. Find the pace that works for you and make consistency your highest standard.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Brand Features",
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Column",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number / Kicker",
          "default": "01 — LIGHTWEIGHT"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "LIGHTWEIGHT"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Comfort-focused apparel designed for ease of movement."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "number": "01",
            "title": "LIGHTWEIGHT",
            "description": "Comfort-focused apparel designed for ease of movement."
          }
        },
        {
          "type": "feature",
          "settings": {
            "number": "02",
            "title": "FUNCTIONAL",
            "description": "Practical silhouettes for running and active everyday life."
          }
        },
        {
          "type": "feature",
          "settings": {
            "number": "03",
            "title": "OWN YOUR PACE",
            "description": "Every run is different. Find the pace that works for you."
          }
        }
      ]
    }
  ]
}
{% endschema %}
