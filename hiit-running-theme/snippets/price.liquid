{%- comment -%}
  Renders a product's price
  Accepts:
  - product: {Object} Product Liquid object (optional)
  - use_variant: {Boolean} Renders selected or first available variant price instead of overall product (optional)
  - show_badges: {Boolean} Renders 'Sale' and 'Sold Out' tags (optional)
  - price_class: {String} Adds a price class to the price element (optional)
{%- endcomment -%}
{%- liquid
  if use_variant
    assign target = product.selected_or_first_available_variant
  else
    assign target = product
  endif

  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 1999
  assign available = target.available | default: false
  assign money_price = price | money
-%}

<div class="price-container {% if price_class %}{{ price_class }}{% endif %}">
  <div class="price-regular">
    <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
    <span class="price-item price-item--regular" style="font-weight: 700;">
      {{ money_price }}
    </span>
    {%- if compare_at_price > price -%}
      <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
      <span class="price-item price-item--compare" style="text-decoration: line-through; color: var(--color-text-secondary); margin-left: 0.5rem; font-size: 0.875em;">
        {{ compare_at_price | money }}
      </span>
    {%- endif -%}
  </div>

  {%- if show_badges -%}
    {%- if compare_at_price > price and target.available -%}
      <span class="badge badge--sale" style="font-size: 0.625rem; font-weight: 700; text-transform: uppercase; background: var(--color-dark-section); color: var(--color-white); padding: 0.2rem 0.5rem; margin-left: 0.5rem;">
        {{ 'products.product.on_sale' | t }}
      </span>
    {%- elsif target.available == false -%}
      <span class="badge badge--soldout" style="font-size: 0.625rem; font-weight: 700; text-transform: uppercase; background: var(--color-border); color: var(--color-text-secondary); padding: 0.2rem 0.5rem; margin-left: 0.5rem;">
        {{ 'products.product.sold_out' | t }}
      </span>
    {%- endif -%}
  {%- endif -%}
</div>
