{%- comment -%}
  Renders a pagination component
  Accepts:
  - paginate: {Object} Paginate Liquid object
{%- endcomment -%}

{%- if paginate.parts.size > 0 -%}
  <nav class="pagination-wrapper" role="navigation" aria-label="Pagination" style="margin-top: 3.5rem; display: flex; justify-content: center; align-items: center; gap: 0.5rem;">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" class="btn btn-secondary" style="padding: 0.6rem 1rem; font-size: 0.75rem;" aria-label="Previous page">
        &larr; PREV
      </a>
    {%- endif -%}

    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}" class="pagination-item" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--color-border); font-size: 0.8125rem; font-weight: 700; color: var(--color-text-primary);" aria-label="Page {{ part.title }}">
          {{ part.title }}
        </a>
      {%- else -%}
        {%- if part.title == paginate.current_page -%}
          <span class="pagination-item is-active" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; background: var(--color-dark-section); color: var(--color-white); font-size: 0.8125rem; font-weight: 700;" aria-current="page">
            {{ part.title }}
          </span>
        {%- else -%}
          <span class="pagination-item" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; font-size: 0.8125rem; color: var(--color-text-secondary);">
            {{ part.title }}
          </span>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" class="btn btn-secondary" style="padding: 0.6rem 1rem; font-size: 0.75rem;" aria-label="Next page">
        NEXT &rarr;
      </a>
    {%- endif -%}
  </nav>
{%- endif -%}
